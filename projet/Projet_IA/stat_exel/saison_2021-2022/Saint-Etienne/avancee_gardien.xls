ass="right " data-stat="gk_crosses_stopped">24</td><td class="right " data-stat="gk_crosses_stopped_pct">7.6</td><td class="right group_start" data-stat="gk_def_actions_outside_pen_area">25</td><td class="right " data-stat="gk_def_actions_outside_pen_area_per90">0.66</td><td class="right " data-stat="gk_avg_distance_def_actions">14.1</td><td class="left iz group_start" data-stat="matches"></td></tr> </tfoot> </table></body></html>